# Runtime
KUBEIQ_ENV=development
KUBEIQ_LOG_LEVEL=INFO
KUBEIQ_LOG_JSON=false
# Only for local development, where the app (:3000) and the API (:8000) are different origins.
# Comma-separated or a JSON list. In Docker both are served on one origin by the proxy.
KUBEIQ_CORS_ORIGINS=http://localhost:3000

# Database: SQLite by default (./kubeiq.db) for local development. Docker Compose runs Postgres and
# sets this itself; set KUBEIQ_DATABASE_URL in ../.env to use your own Postgres there.
# KUBEIQ_DATABASE_URL=postgresql+asyncpg://kubeiq:password@localhost:5432/kubeiq

# Settings page secrets (AI keys, uploaded kubeconfigs) are encrypted at rest.
# Set a long random string here, or leave empty to generate a key file in KUBEIQ_DATA_DIR.
# Keep it stable: changing it makes saved secrets unreadable.
# KUBEIQ_SECRET_KEY=

# Master key: the built-in admin signs in with username "admin" and this key, and API clients can
# send it as "Authorization: Bearer <key>". Leave empty to generate one into KUBEIQ_DATA_DIR
# (.kubeiq-master-key) on first start. The installer sets it for you.
# KUBEIQ_MASTER_KEY=

# Sign in with Google returns to the app here when the app runs on another origin than the API
# (local development only). Docker serves both on one origin, so leave it empty there.
# KUBEIQ_APP_URL=http://localhost:3000
# KUBEIQ_DATA_DIR=.

# Kubernetes (defaults to ~/.kube/config when empty). More kubeconfigs can be added in Settings.
KUBEIQ_KUBECONFIG=
# In Docker, reach kind/minikube/k3d clusters on the host (servers at 127.0.0.1)
KUBEIQ_KUBECONFIG_LOCALHOST_ALIAS=
# KubeiQ Agent image for the served install manifest (default: the published image of this version)
# KUBEIQ_AGENT_IMAGE=

# LLM via LiteLLM: any provider. The Settings page overrides these values when a model is saved.
# Examples for KUBEIQ_LLM_MODEL:
#   LiteLLM proxy : <model-alias> or openai/<model-alias>  (+ KUBEIQ_LLM_API_BASE, KUBEIQ_LLM_API_KEY)
#   Any OpenAI-compatible gateway (vLLM, LM Studio, ...) works the same way
#   OpenAI        : openai/gpt-4.1
#   Anthropic     : anthropic/<model-id>
#   OpenRouter    : openrouter/<vendor>/<model>
#   Azure OpenAI  : azure/<deployment>             (+ KUBEIQ_LLM_API_BASE)
#   AWS Bedrock   : bedrock/<model-id>             (uses AWS credentials)
#   Gemini        : gemini/<model>
#   Ollama        : ollama/llama3.1                (+ KUBEIQ_LLM_API_BASE=http://localhost:11434)
# Leave KUBEIQ_LLM_MODEL empty to run with rule-based diagnosis only.
KUBEIQ_LLM_MODEL=
KUBEIQ_LLM_API_BASE=
KUBEIQ_LLM_API_KEY=
# Provider keys can also be set with their standard names (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...)

# Usage history for trend lines: seconds between samples per cluster (0 turns it off)
KUBEIQ_USAGE_SAMPLE_SECONDS=60

# How often the alert engine checks clusters for notifications (0 turns it off)
KUBEIQ_ALERT_SECONDS=60
