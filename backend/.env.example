# Runtime
KUBEIQ_ENV=development
KUBEIQ_LOG_LEVEL=INFO
KUBEIQ_LOG_JSON=false
KUBEIQ_CORS_ORIGINS=["http://localhost:3000"]

# Kubernetes (defaults to ~/.kube/config when empty)
KUBEIQ_KUBECONFIG=

# LLM via LiteLLM, e.g. openrouter/anthropic/claude-sonnet-4.5, gpt-4o, ollama/llama3.1
KUBEIQ_LLM_MODEL=
# Provider keys are read by LiteLLM using their standard names:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
