# Runtime
KUBEIQ_ENV=development
KUBEIQ_LOG_LEVEL=INFO
KUBEIQ_LOG_JSON=false
KUBEIQ_CORS_ORIGINS=["http://localhost:3000"]

# Database: SQLite by default (./kubeiq.db locally, /data/kubeiq.db in Docker); Postgres for production
# KUBEIQ_DATABASE_URL=postgresql+asyncpg://kubeiq:password@localhost:5432/kubeiq

# Kubernetes (defaults to ~/.kube/config when empty)
KUBEIQ_KUBECONFIG=
# In Docker, reach kind/minikube/k3d clusters on the host (servers at 127.0.0.1)
KUBEIQ_KUBECONFIG_LOCALHOST_ALIAS=

# LLM via LiteLLM: any provider. Examples for KUBEIQ_LLM_MODEL:
#   LiteLLM proxy : <model-alias> or openai/<model-alias>  (+ KUBEIQ_LLM_API_BASE, KUBEIQ_LLM_API_KEY)
#   Any OpenAI-compatible gateway (vLLM, LM Studio, ...) works the same way
#   OpenAI        : openai/gpt-4.1
#   Anthropic     : anthropic/<model-id>
#   OpenRouter    : openrouter/<vendor>/<model>
#   Azure OpenAI  : azure/<deployment>             (+ KUBEIQ_LLM_API_BASE)
#   AWS Bedrock   : bedrock/<model-id>             (uses AWS credentials)
#   Gemini        : gemini/<model>
#   Ollama        : ollama/llama3.1                (+ KUBEIQ_LLM_API_BASE=http://localhost:11434)
# Leave KUBEIQ_LLM_MODEL empty to run with rule-based diagnosis only.
KUBEIQ_LLM_MODEL=
KUBEIQ_LLM_API_BASE=
KUBEIQ_LLM_API_KEY=
# Provider keys can also be set with their standard names (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...)
